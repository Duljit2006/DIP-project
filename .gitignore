# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Checkpoints & model weights (track weights so Colab / deployments work out of the box)
# checkpoints/*.pth
# checkpoints/*.pt

# Evaluation output images (keep directory, ignore outputs)
results/*
!results/.gitkeep

# Environments & IDEs
.venv/
venv/
env/
.vscode/
.idea/

# OS specific files
.DS_Store
Thumbs.db

# Large datasets archive/temp
*.tar
*.tar.gz
*.tgz
*.zip
data/

# Office temporary lock files & generated presentation binary (run scripts/build_presentation.py to rebuild)
~$*
*.pptx

# Raw Stitch export folder (superseded by integrated web/index.html)
stitch_neurodct_artifact_reduction_lab/

# Logs & caches
*.log
.cache/
